{
  "$schema": "https://raw.githubusercontent.com/OpenAPITools/openapi-generator-cli/refs/heads/master/apps/generator-cli/src/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.14.0",
    "repository": "https://github.com/rezkit/tour-manager",
    "generators": {
      "go": {
        "httpUserAgent": "RezKit/TourManager.go",
        "generatorName": "go",
        "gitUserId": "rezkit",
        "gitRepoId": "tour-manager",
        "gitHost": "github.com",
        "packageName": "github.com/rezkit/tour-manager",
        "inputSpec": "openapi.yml",
        "apiPackage": "tourmanager",
        "modelPackage": "models",
        "output": "."
      }
    }
  }
}
